{
  "extends": ["config:recommended", "group:allNonMajor", ":semanticCommits"],
  "enabledManagers": ["cargo", "github-actions"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackageNames": ["**"],
      "allowedVersions": "!/\\-SNAPSHOT$/"
    }
  ]
}
